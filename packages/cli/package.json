{
  "name": "mpctl",
  "version": "0.1.0",
  "description": "给 AI Agent 用的微信公众号草稿编辑工具",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-w-xiaohei/mpctl.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mpctl": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/brand/*.png"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-cli.ts",
    "prepack": "bun run build",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@nexus-js/core": "2.0.0-alpha.2",
    "@nexus-js/node-ipc": "0.7.0-alpha.2",
    "@nexus-js/websocket": "0.1.0-alpha.3",
    "better-result": "3.0.1",
    "commander": "15.0.0",
    "valibot": "1.5.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@mpctl/broker": "workspace:*",
    "@mpctl/contracts": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
