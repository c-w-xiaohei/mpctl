{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["bun", "chrome"],
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    ".wxt/types/globals.d.ts",
    ".wxt/types/i18n.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
